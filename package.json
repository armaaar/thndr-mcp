{
  "name": "thndr-mcp",
  "version": "0.1.0",
  "description": "Community MCP server for Thndr (Egyptian Exchange broker) — reverse-engineered, unofficial.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "thndr-mcp": "dist/thndr-mcp.js",
    "thndr": "dist/thndr.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/presentation/mcp/main.ts",
    "start": "node dist/thndr-mcp.js",
    "login": "tsx src/presentation/cli/main.ts login",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run coverage",
    "sync:api": "tsx .claude/skills/sync-thndr-api/scripts/sync-thndr-bundle.ts",
    "capture:fixtures": "tsx .claude/skills/sync-thndr-api/scripts/capture-fixtures.ts",
    "cli": "tsx src/presentation/cli/main.ts",
    "find:call-sites": "tsx .claude/skills/sync-thndr-api/scripts/find-call-sites.ts"
  },
  "dependencies": {
    "@firebase/app": "^0.16.2",
    "@firebase/auth": "^1.13.6",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "qrcode": "^1.5.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/js-beautify": "^1.14.3",
    "@types/node": "^26.6.4",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "^5.0.3",
    "js-beautify": "^2.0.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
