{
  "name": "thndr-mcp",
  "version": "0.1.0",
  "description": "Unofficial, community MCP server and CLI for the Thndr broker — not affiliated with Thndr; not financial advice; use at your own risk.",
  "license": "Apache-2.0",
  "author": "armaaar",
  "homepage": "https://github.com/armaaar/thndr-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/armaaar/thndr-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/armaaar/thndr-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "thndr",
    "egx",
    "egypt",
    "stocks",
    "cli",
    "unofficial"
  ],
  "type": "module",
  "bin": {
    "thndr-mcp": "dist/thndr-mcp.js",
    "thndr": "dist/thndr.js"
  },
  "files": [
    "dist",
    "NOTICE",
    "DISCLAIMER.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "prepare": "tsup",
    "dev": "tsx src/presentation/mcp/main.ts",
    "start": "node dist/thndr-mcp.js",
    "login": "tsx src/presentation/cli/main.ts login",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run coverage",
    "sync:api": "tsx .claude/skills/sync-thndr-web-api/scripts/sync-thndr-bundle.ts",
    "capture:fixtures": "tsx .claude/skills/sync-thndr-web-api/scripts/capture-fixtures.ts",
    "cli": "tsx src/presentation/cli/main.ts",
    "find:call-sites": "tsx .claude/skills/sync-thndr-web-api/scripts/find-call-sites.ts",
    "sync:mobile": "bash .claude/skills/sync-thndr-mobile-api/scripts/fetch-apk.sh && bash .claude/skills/sync-thndr-mobile-api/scripts/decompile.sh"
  },
  "dependencies": {
    "@firebase/app": "^0.16.2",
    "@firebase/auth": "^1.13.6",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "qrcode": "^1.5.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/js-beautify": "^1.14.3",
    "@types/node": "^26.6.4",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "^5.0.3",
    "js-beautify": "^2.0.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
